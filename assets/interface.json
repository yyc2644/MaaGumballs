  "task": [
    {
      "name": "启动游戏",
      "entry": "Start_Up",
      "doc": [
        "## 新版本可以来github下载最新的资源包,[MaaGumballs](https://github.com/KhazixW2/MaaGumballs)",
        "## 自动化黑盒测试工具用户许可协议",
        "",
        "### 第一条 定义",
        "- **本软件**:指该自动化黑盒测试工具",
        "- **用户**:指使用本软件的个人或实体",
        "- **第三方应用**:指本软件测试的目标应用程序",
        "",
        "### 第二条 使用授权",
        "用户获得使用本软件的非独占、不可转让的许可。",
        "",
        "### 第三条 用户义务",
        "- 用户承诺已充分阅读并理解第三方应用的用户协议",
        "- 用户确认同意第三方应用的所有条款和条件",
        "- 用户保证仅将本软件用于合法的测试目的",
        "- 用户承担因使用本软件而产生的所有责任",
        "",
        "### 第四条 免责条款",
        "- 本软件按\"现状\"提供,不提供任何明示或暗示的保证",
        "- 开发者不对用户使用本软件造成的任何损失承担责任",
        "- 用户理解并接受使用本软件的风险",
        "",
        "### 第五条 协议生效",
        "用户使用本软件即表示接受本协议的所有条款。"
      ]
    },
    {
      "name": "91-1201",
      "entry": "Map91",
      "repeatable": true,
      "repeat_count": 1,
      "option": [
        "自动肉鸽时使用钻石购买体力",
        "91-1201目标层数",
        "91-1201结算方式",
        "小怪层打怪",
        "小怪层探索"
      ],
      "pipeline_override": {
        "Select_WorldTree_InputBox_Text": {
          "input_text": "仿生人"
        },
        "Select_Drug_Next": {
          "template": "items/电能试剂.png"
        },
        "Select_Artifact_Next": {
          "template": "equipments/7level/冒险家竖琴.png"
        },
        "select_InputBox_Text1": {
          "input_text": "太阳冈布奥"
        },
        "select_InputBox_Text2": {
          "input_text": "天启者"
        },
        "Map91_Target_Layer_Setting": {
          "expected": "1199"
        }
      },
      "doc": [
        "## 91-1201自动化",
        "- 当前版本先按通用副本框架拆分：小怪层刷怪、小怪层搜刮、Boss层、称号、生存、特殊层、大地之门和结算独立维护",
        "- 默认配置参考玛尔斯：仿生人 + 太阳冈布奥 + 天启者，电能试剂，冒险家竖琴",
        "- 默认目标：清理到 1199 层后暂离保存",
        "- 具体事件、建筑和Boss固定解法后续按截图逐项补充"
      ]
    },
    {
      "name": "91-1201小怪层打怪调试",
      "entry": "Map91_Debug_MonsterPhase",
      "repeatable": true,
      "repeat_count": 1,
      "doc": [
        "## 91-1201小怪层打怪调试",
        "- 对当前小怪层执行翻地板和打怪",
        "- 不执行进图、搜刮、下楼"
      ]
    },
    {
      "name": "91-1201小怪层搜刮调试",
      "entry": "Map91_Debug_LootPhase",
      "repeatable": true,
      "repeat_count": 1,
      "doc": [
        "## 91-1201小怪层搜刮调试",
        "- 仅对当前小怪层执行搜刮阶段",
        "- 不执行进图、打怪、下楼"
      ]
    },
    {
      "name": "91-1201连续小怪层调试",
      "entry": "Map91_ContinuousMonsterLoop",
      "repeatable": true,
      "repeat_count": 1,
      "doc": [
        "## 91-1201连续小怪层调试",
        "- 从当前小怪层开始循环清图和下楼",
        "- 到尾号9的楼层清完后停止"
      ]
    },
    {
      "name": "91-1201格斗家技能调试",
      "entry": "Map91_Debug_FighterSkill",
      "repeatable": true,
      "repeat_count": 1,
      "doc": [
        "## 91-1201格斗家技能调试",
        "- 只执行格斗家技能的识别和释放",
        "- 不执行进图、清图、搜刮、下楼"
      ]
    },
    {
      "name": "91-1201拉绳子调试",
      "entry": "GetKeyFromHole",
      "repeatable": true,
      "repeat_count": 1,
      "doc": [
        "## 拉绳子调试",
        "- 仅执行神秘洞穴的找钥匙孔和拉绳动作",
        "- 不执行进图、战斗、下楼或完整副本流程",
        "- 请先将模拟器停留在拉绳子界面再启动此入口"
      ]
    }
  ],
  "option": {
    "AutoCdkText": {
      "type": "input",
      "label": "密令文本",
      "description": "自动兑换密令功能，输入密令之间使用, ; / 分开",
      "inputs": [
        {
          "name": "cdk_text",
          "default": "",
          "pipeline_type": "string"
        }
      ],
      "pipeline_override": {
        "Cdk_Sources": {
          "focus": "{cdk_text}"
        }
      }
    },
    "天空_出战阵营": {
      "default_case": "深渊",
      "description": "选择出战的冈布奥阵营",
